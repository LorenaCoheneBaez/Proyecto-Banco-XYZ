{
  "expo": {
    "name": "ProyectoBancoXYZ",
    "slug": "ProyectoBancoXYZ",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "proyectobancoxyz",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
